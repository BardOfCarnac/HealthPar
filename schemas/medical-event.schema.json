{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://healthpar.radian.invalid/schemas/medical-event.schema.json",
  "title": "HealthPar Medical Event",
  "type": "object",
  "additionalProperties": false,
  "required": ["eventId", "recordId", "characterId", "continuityId", "sequence", "occurredAt", "recordedAt", "type", "payload"],
  "properties": {
    "eventId": {"type": "string", "minLength": 1},
    "recordId": {"type": "string", "minLength": 1},
    "characterId": {"type": "string", "minLength": 1},
    "continuityId": {"type": "string", "minLength": 1},
    "sequence": {"type": "integer", "minimum": 1},
    "occurredAt": {"type": "string", "format": "date-time"},
    "recordedAt": {"type": "string", "format": "date-time"},
    "actorId": {"type": ["string", "null"]},
    "source": {"enum": ["rules_engine", "medscan", "gm", "import", "system", "other"]},
    "type": {
      "enum": [
        "record_created",
        "baselines_changed",
        "damage_sustained",
        "additional_critical_injury_required",
        "critical_injury_added",
        "critical_injury_state_changed",
        "condition_added",
        "condition_updated",
        "condition_resolved",
        "death_save_rolled",
        "care_recorded",
        "treatment_attempted",
        "treatment_outcome_recorded",
        "stabilisation_changed",
        "consciousness_changed",
        "recovery_interrupted",
        "recovery_state_changed",
        "healing_advanced",
        "medical_time_advanced",
        "clock_mode_changed",
        "timed_effect_added",
        "timed_effect_expired",
        "timed_effect_acknowledged",
        "drug_secondary_check_recorded",
        "addiction_changed",
        "pharmaceutical_administered",
        "hit_points_restored",
        "humanity_changed",
        "therapy_recorded",
        "cyberware_installed",
        "cyberware_updated",
        "cyberware_state_changed",
        "cyberware_removed",
        "cryotech_changed",
        "anatomy_marker_added",
        "anatomy_marker_updated",
        "anatomy_marker_removed",
        "note_added",
        "correction_applied"
      ]
    },
    "causedByEventId": {"type": ["string", "null"]},
    "correlationId": {"type": ["string", "null"]},
    "payload": {"type": "object"}
  }
}
